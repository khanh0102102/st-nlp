# Local development defaults only. Never reuse these values outside a private local machine.
APP_ENV=development
SECRET_KEY=local-only-change-before-any-shared-environment
WEB_PORT=8080

POSTGRES_DB=stnlp
POSTGRES_USER=stnlp
POSTGRES_PASSWORD=stnlp_local_only_change_me

CORS_ORIGINS=http://localhost:8080
UPLOADS_DIR=/data/uploads
MODEL_ARTIFACTS_DIR=/data/model-artifacts
AUDIT_LOG_PATH=/data/audit/audit-events.jsonl

# Optional Google OpenID Connect credentials.
# Register this exact redirect URI in the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
